# ============================================================
# ONYX AI社員 — 環境変数
# このファイルを .env にコピーして値を入れてください。
# .env は .gitignore 済みです。認証情報は絶対にコミットしないこと。
# ============================================================

# --- 必須 ---------------------------------------------------
# AI社員の頭脳。https://console.anthropic.com で発行する。
# `ant auth login` でプロファイルを作っている場合は未設定でも動く。
ANTHROPIC_API_KEY=

# --- データベース --------------------------------------------
# DATABASE_URL を設定すると Postgres、未設定なら SQLite。
# これがそのままデプロイ先の選択になる:
#   Render / Railway など   → Postgres（ファイルシステムが永続しないため）
#                             Render では fromDatabase で自動注入されるので設定不要
#   VPS に1台で載せる       → 未設定のまま（SQLite）
DATABASE_URL=

# SQLite のときの保存先。
ONYX_DB_PATH=./data/onyx.sqlite

# Postgres の接続プール上限（1プロセスあたり）。既定5。
# サーバーレスではプロセス数を制御できないので、
# プーラー付きの接続文字列（Neon / Supabase の pgbouncer）を使うこと。
PGPOOL_MAX=

# ローカル検証など、TLS 無しの Postgres に繋ぐときだけ disable にする。
# マネージドPostgresでは設定しないこと。
PGSSL=

# 複数店舗を入れている場合に、画面が見るテナントを固定する。
# 未設定なら最初に作られたテナントを使う。
ONYX_TENANT_ID=

# 承認画面の操作者名。監査ログに残る。
ONYX_OPERATOR_NAME=店長

# --- Google（Gmail / カレンダー）-----------------------------
# 未設定の場合はモックで動作する。全画面・全機能は動くが、
# 実際のメール送信とカレンダー登録は行われない。
#
# 取得手順:
#   1. Google Cloud Console で OAuth クライアント（デスクトップ）を作成
#   2. スコープ gmail.modify と calendar.events で同意画面を通す
#   3. 得られたリフレッシュトークンを下に入れる
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 単一店舗運用のときだけ、リフレッシュトークンをここに置ける。
# 複数店舗では connector_accounts テーブルに店舗ごとに保存する。
GOOGLE_REFRESH_TOKEN=

# --- Instagram（Meta Graph API）------------------------------
# 未設定の場合はモックで動作する（下書きは作られるが実投稿はされない）。
#
# 前提:
#   - Instagram を「プロアカウント（ビジネス）」にし、Facebookページと連携していること
#   - Meta 開発者アプリを作り、instagram_basic と instagram_content_publish の
#     権限でアプリレビューを通していること
#
# 取得手順:
#   1. Meta for Developers でアプリを作成し、Instagram Graph API を追加
#   2. 短期トークンを長期トークン（60日）に交換する
#   3. GET /me/accounts → GET /{page-id}?fields=instagram_business_account で
#      Instagram プロアカウントのID（数値）を得る
#
# 注意: 長期トークンは60日で失効する。期限前に更新する運用が必要。
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=

# Graph API のバージョン。未指定なら v25.0。
# Meta は概ね四半期ごとに新版を出し、旧版は約2年で廃止される。
# 本番投入前に現行バージョンを確認して固定すること。
INSTAGRAM_GRAPH_VERSION=

# --- スケジューラ --------------------------------------------
# Vercel Cron から /api/cron/tick を叩くときの共有鍵。
# 本番では必ず設定すること。未設定だと本番では 401 を返す。
CRON_SECRET=
