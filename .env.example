# ============================================================
# ONYX AI社員 — 環境変数
# このファイルを .env にコピーして値を入れてください。
# .env は .gitignore 済みです。認証情報は絶対にコミットしないこと。
# ============================================================

# --- 必須 ---------------------------------------------------
# AI社員の頭脳。https://console.anthropic.com で発行する。
# `ant auth login` でプロファイルを作っている場合は未設定でも動く。
ANTHROPIC_API_KEY=

# --- データベース --------------------------------------------
# 既定は ./data/onyx.sqlite。Vercel など書き込み不可の環境では
# Postgres へ差し替える（src/lib/db/client.ts と repo.ts を置き換える）。
ONYX_DB_PATH=./data/onyx.sqlite

# 複数店舗を入れている場合に、画面が見るテナントを固定する。
# 未設定なら最初に作られたテナントを使う。
ONYX_TENANT_ID=

# 承認画面の操作者名。監査ログに残る。
ONYX_OPERATOR_NAME=店長

# --- Google（Gmail / カレンダー）-----------------------------
# 未設定の場合はモックで動作する。全画面・全機能は動くが、
# 実際のメール送信とカレンダー登録は行われない。
#
# 取得手順:
#   1. Google Cloud Console で OAuth クライアント（デスクトップ）を作成
#   2. スコープ gmail.modify と calendar.events で同意画面を通す
#   3. 得られたリフレッシュトークンを下に入れる
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 単一店舗運用のときだけ、リフレッシュトークンをここに置ける。
# 複数店舗では connector_accounts テーブルに店舗ごとに保存する。
GOOGLE_REFRESH_TOKEN=

# --- スケジューラ --------------------------------------------
# Vercel Cron から /api/cron/tick を叩くときの共有鍵。
# 本番では必ず設定すること。未設定だと本番では 401 を返す。
CRON_SECRET=
